# Copy this file to .env and fill in your values. .env is ignored by git.
# Real environment variables take precedence over values in .env.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Required: signs login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=

# The PostgreSQL database. Defaults to postgresql+psycopg://localhost/ask_ai
# DATABASE_URL=postgresql+psycopg://user:password@localhost/ask_ai

# The mail server for password reset emails. When SMTP_HOST is unset, the
# emails are logged instead of sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# EMAIL_FROM=ask-ai <noreply@example.com>
# The page where users choose a new password; the email links to it.
# PASSWORD_RESET_URL=https://example.com/reset-password

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-4-carbon
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
